{
  "name": "rotterdam-approach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:sim": "esbuild scripts/simtest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/simtest.mjs --log-level=warning && node node_modules/.cache/simtest.mjs 24 | grep SCORE && node node_modules/.cache/simtest.mjs 06 | grep SCORE && node node_modules/.cache/simtest.mjs 27 KSAN | grep SCORE && node node_modules/.cache/simtest.mjs 23 KORF | grep SCORE",
    "test:idle": "esbuild scripts/idletest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/idle.mjs --log-level=warning && node node_modules/.cache/idle.mjs",
    "airport:us": "python3 scripts/cifp/build_airport.py",
    "logos": "node scripts/fetch-logos.mjs",
    "test:golden": "node scripts/golden.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "mapbox-gl": "^3.33.0",
    "pixi.js": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.6",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}

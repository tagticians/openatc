# Copy to .env.local and fill in what you have. Everything is optional:
# without keys the game runs with system voices, no base map and a synthetic schedule.
# Players can also paste their own speech keys in Settings → Voices (kept in their browser).

# Base map + load-screen flyover (public "pk." token from account.mapbox.com)
MAPBOX_API_KEY=

# Cloud pilot voices: LOCAL TESTING ONLY (dev server; hidden in production builds).
# Budgets cap what the server's own keys may spend. The shipped game uses system voices or Kokoro.
ELEVENLABS_API_KEY=
TTS_BUDGET=20000
OPENAI_API_KEY=
TTS_BUDGET_OPENAI=100000
GEMINI_API_KEY=
TTS_BUDGET_GEMINI=100000
MISTRAL_API_KEY=
TTS_BUDGET_MISTRAL=100000

# Real airport schedule (AeroDataBox on RapidAPI; at most 2 cached calls per airport per day)
AERODATABOX_API_KEY=
